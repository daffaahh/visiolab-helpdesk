generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
  STAFF
  DEVELOPER
  DESIGNER
}

enum Status {
  DRAFT
  PENDING
  IN_PROGRESS
  REVIEW
  REVISION
  DONE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String
  phone         String?
  companyName   String?
  role          Role      @default(CLIENT) // <-- FIX: Pake Enum Role, bukan String lagi
  activeUntil   DateTime?
  createdAt     DateTime  @default(now())

  tickets Ticket[] // <-- FIX: Ini relation bolak-baliknya yang bikin error tadi
}

model Category {
  id      Int      @id @default(autoincrement())
  name    String
  tickets Ticket[]
}

// HEADER: data ringkas tiket (dipakai buat listing & dashboard)
model Ticket {
  id         String        @id @default(uuid())
  title      String
  status     Status        @default(PENDING)
  priority   String        @default("MEDIUM")
  dueDate    DateTime? // deadline; dipakai eskalasi prioritas otomatis
  clientId   String
  client     User          @relation(fields: [clientId], references: [id])
  categoryId Int
  category   Category      @relation(fields: [categoryId], references: [id])
  detail     TicketDetail? // <-- Relasi 1-ke-1 ke konten/detail
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Index buat query yang sering: filter status (dashboard) & join FK
  @@index([status])
  @@index([clientId])
  @@index([categoryId])
}

// KONTEN: detail berat tiket, dipisah dari header (1-ke-1 dengan Ticket).
// Field umum dipegang kolom eksplisit; field spesifik per kategori
// (mis. resolusi video, dimensi desain, dsb) ditampung di customFields (JSONB).
model TicketDetail {
  id             String   @id @default(uuid())
  ticketId       String   @unique
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  description    String
  referenceLinks String[]
  customFields   Json? // <-- field dinamis sesuai category masing-masing
  outputLinks    String[]  @default([]) // hasil kerjaan (link drive) dari tim
  revisionNote   String? // catatan revisi terakhir dari client
  revisionAsset  String? // link aset pendukung revisi dari client
  assets         Asset[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Asset {
  id             String       @id @default(uuid())
  fileName       String
  fileUrl        String
  ticketDetailId String
  ticketDetail   TicketDetail @relation(fields: [ticketDetailId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}
